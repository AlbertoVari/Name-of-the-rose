      "uncertainties": [
        "The source restoration logic is local to one GL record, not a transaction coordinator for debit and credit calls."
      ]
    },
    {
      "@id": "urn:rose:rule.gl_normal_side",
      "@type": "rose:BusinessRule",
      "description": "For debit-normal GL accounts, matching the entry credit account subtracts balance and accumulates credits; otherwise POST adds balance and accumulates debits. For credit-normal accounts, matching entry debit subtracts balance and accumulates debits; otherwise it adds balance and accumulates credits. The caller must perform both sides separately. Double-entry accounting therefore depends on explicit caller orchestration.",
      "epistemic_status": "observed",
      "evidence": [
        {
          "end_line": 64,
          "excerpt_sha256": "3df14aa48108a9fcea43dbb089614d4f579df66f681688123ecc4bc62fb2ad3e",
          "path": "src/GLPOST0.cob",
