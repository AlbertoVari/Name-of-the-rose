    {
      "@id": "urn:rose:rule.audit_record_preparation",
      "@type": "rose:BusinessRule",
      "description": "WRIT stamps timestamp, process-local ID and sequence=1 then returns success. READ only checks that entity key is nonblank. EODPROC0 provides account identity and fixed E0000 audit result and does not inspect the logger result after calling it.",
      "epistemic_status": "observed",
      "evidence": [
        {
          "end_line": 91,
          "excerpt_sha256": "8ab9519517fcc4ad918a8735893a06f90a9efd841a127731d7f7e22712f9367b",
          "path": "src/AUDTLOG0.cob",
          "permalink": "https://github.com/NSEvent/cobol-banking-system/blob/03ea874c84b5c00b11b78c6ca1498ec1a9cb7bb4/src/AUDTLOG0.cob#L56-L91",
          "start_line": 56
        },
        {
          "end_line": 400,
          "excerpt_sha256": "7ade84dc0e2a6280069f040a9e6e167ab129ca03049554d6371dcf29ce864d79",
          "path": "src/EODPROC0.cob",
          "permalink": "https://github.com/NSEvent/cobol-banking-system/blob/03ea874c84b5c00b11b78c6ca1498ec1a9cb7bb4/src/EODPROC0.cob#L387-L400",
          "start_line": 387
        }
      ],
      "label": "Audit annotation without durable logging",
      "uncertainties": [
        "No storage I/O, append-only protection, retrieval, retention or before/after capture is implemented by AUDTLOG0.",
        "EOD audit result text may not reflect earlier account-processing errors."
      ]
    },
    {
      "@id": "urn:rose:rule.bsa_contextual_signals",
      "@type": "rose:BusinessRule",
      "description": "STRC combines cash-in and cash-out and flags E0082/Y when the sum is within 8000.00 through 9999.99 inclusive and combined count > 1. SARQ sets the same required flag Y when CTR-FILING-STATUS=P. These are distinct meanings of an overloaded result field.",
      "epistemic_status": "observed",
      "evidence": [
        {
          "end_line": 241,
          "excerpt_sha256": "132280b5d7d7a3e56dde17ee817384d5c9a423be903e794fd6ff4fda356d6b3e",
          "path": "src/BSACTRO.cob",
          "permalink": "https://github.com/NSEvent/cobol-banking-system/blob/03ea874c84b5c00b11b78c6ca1498ec1a9cb7bb4/src/BSACTRO.cob#L182-L241",
          "start_line": 182
        },
        {
          "end_line": 14,
          "excerpt_sha256": "4e56a180f8964f10a259fe55e2c8cc82cf28c27537a7895156ef17e65429c1aa",
          "path": "copybooks/CPYCONST.cpy",
          "permalink": "https://github.com/NSEvent/cobol-banking-system/blob/03ea874c84b5c00b11b78c6ca1498ec1a9cb7bb4/copybooks/CPYCONST.cpy#L11-L14",
          "start_line": 11
        }
      ],
      "label": "Operation-specific SAR signals",
      "uncertainties": [
        "The source heuristic is not a verified legal rule or a general suspicious-activity detector.",
        "SARQ does not retrieve a separate SAR record; pending CTR status is interpreted as a pending SAR signal.",
        "An Italian SOS cannot be inferred from either flag."
      ]
    },
    {
      "@id": "urn:rose:rule.bsa_ctr_assessment",
      "@type": "rose:BusinessRule",
      "description": "CHEK excludes explicit exempt=Y and is_cash=N before checking single amount and existing directional totals. AGGR accumulates first and then returns without threshold assessment for exempt=Y. Otherwise each path marks required when a checked amount or a directional total is strictly greater than 10000.00; incoming and outgoing totals are not netted or added for CTR threshold comparison.",
      "epistemic_status": "observed",
      "evidence": [
        {
          "end_line": 88,
          "excerpt_sha256": "0f6f148b311f2efa0337a402b35ef9947f2a6b853ffd7f26c77307c4e26154e4",
          "path": "src/BSACTRO.cob",
          "permalink": "https://github.com/NSEvent/cobol-banking-system/blob/03ea874c84b5c00b11b78c6ca1498ec1a9cb7bb4/src/BSACTRO.cob#L56-L88",
          "start_line": 56
        },
        {
          "end_line": 175,
          "excerpt_sha256": "47037d6a3f3c8459a9324a67b7c1a39657c1c50981373b1633cbd9b20777da72",
          "path": "src/BSACTRO.cob",
          "permalink": "https://github.com/NSEvent/cobol-banking-system/blob/03ea874c84b5c00b11b78c6ca1498ec1a9cb7bb4/src/BSACTRO.cob#L154-L175",
          "start_line": 154
        },
        {
          "end_line": 8,
          "excerpt_sha256": "7be713b1b12cc5eb7dca79100bff93ce374480bc9188b4f0463575a600d9a7b9",
          "path": "copybooks/CPYCONST.cpy",
          "permalink": "https://github.com/NSEvent/cobol-banking-system/blob/03ea874c84b5c00b11b78c6ca1498ec1a9cb7bb4/copybooks/CPYCONST.cpy#L7-L8",
          "start_line": 7
        }
      ],
      "label": "Separate directional CTR threshold assessment",
      "uncertainties": [
        "CHEK excludes only the explicit N cash flag; other non-Y values are not rejected before threshold assessment.",
        "No currency validation or Italian regulatory mapping is implemented by these branches."
      ]
    },
    {
      "@id": "urn:rose:rule.bsa_customer_day_key",
      "@type": "rose:BusinessRule",
      "description": "AGGR initializes CTR-CUST-ID and CTR-TXN-DATE when CTR-CUST-ID=0; otherwise both must match the input or it returns E0002. This guard executes before the cash flag check. Account number is not part of the key.",
      "epistemic_status": "observed",
      "evidence": [
        {
          "end_line": 114,
          "excerpt_sha256": "dc5efc1c21e67335a12f8bdf7f4b7484a13a06590892ddc7b23d6c3d94715abb",
          "path": "src/BSACTRO.cob",
          "permalink": "https://github.com/NSEvent/cobol-banking-system/blob/03ea874c84b5c00b11b78c6ca1498ec1a9cb7bb4/src/BSACTRO.cob#L98-L114",
          "start_line": 98
        },
        {
          "end_line": 25,
