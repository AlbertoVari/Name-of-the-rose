          "start_line": 113
        }
      ],
      "label": "Pending-to-filed or pending-to-void transitions",
      "uncertainties": [
        "The FILE message says filed with FinCEN, but the executable paragraph only changes linkage state and return values.",
        "The model does not equate the US CTR lifecycle with Italian UIF reporting."
      ]
    },
    {
      "@id": "urn:rose:rule.gl_local_rollback",
      "@type": "rose:BusinessRule",
      "description": "A month-to-date accumulator size error restores the saved GL current balance. A year-to-date accumulator size error restores the saved current balance and corresponding month-to-date accumulator. On successful arithmetic the routine maps the US Call Report line and copies posting date.",
      "epistemic_status": "observed",
      "evidence": [
