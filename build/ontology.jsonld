    {
      "@id": "urn:rose:rule.bsa_directional_accumulation",
      "@type": "rose:BusinessRule",
      "description": "For LS-BSA-IS-CASH=Y, I adds amount and increments cash-in count, O adds amount and increments cash-out count; another direction returns E0089. Values other than Y do not accumulate. Size errors return E0040.",
      "epistemic_status": "observed",
      "evidence": [
        {
          "end_line": 155,
          "excerpt_sha256": "d4c23e38176007aafdcf6b12f691e305490926ddaafbf3c2aa4c8039b4287f09",
