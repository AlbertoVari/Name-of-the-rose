          "start_line": 114
        }
      ],
      "label": "Directional cash accumulation",
      "uncertainties": [
        "No positive-amount check, duplicate-event check or account-list population occurs in this paragraph.",
        "A count overflow can occur after its amount accumulator has already changed; no compensating rollback is implemented."
      ]
    },
    {
      "@id": "urn:rose:rule.ctr_create",
      "@type": "rose:BusinessRule",
      "description": "CRTE requires nonzero customer ID and at least one positive directional cash total. It assigns the next process-local filing ID, stamps current date/time and sets P. It does not check a 10000 threshold, exemption or a previous filing status.",
      "epistemic_status": "observed",
      "evidence": [
        {
          "end_line": 107,
          "excerpt_sha256": "1346e3a82966d057331d41b6c9e16031eb2922dede1b6bd0d87c2142bd1db68a",
          "path": "src/CTRFIL0.cob",
