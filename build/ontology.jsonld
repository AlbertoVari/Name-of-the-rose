          "start_line": 221
        }
      ],
      "label": "One-side GL input guards",
      "uncertainties": [
        "Status values other than I and F pass these status guards, even if not documented by CPYGL.",
        "E0063 is overloaded for zero amount and invalid normal balance."
      ]
    },
    {
      "@id": "urn:rose:rule.gl_trial_balance",
      "@type": "rose:BusinessRule",
      "description": "TBAL uses caller totals unless both are zero, in which case it copies the supplied GL record MTD totals. It computes debits minus credits and sets Y only for zero difference. EODPROC0 initializes the GL record and totals to zero before calling TBAL.",
