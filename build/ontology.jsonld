          "start_line": 54
        },
        {
          "end_line": 226,
          "excerpt_sha256": "1f34e1543d45cc4c090cc897af62ed4260c820ff56c6056c32de46216cc978dd",
          "path": "src/GLPOST0.cob",
          "permalink": "https://github.com/NSEvent/cobol-banking-system/blob/03ea874c84b5c00b11b78c6ca1498ec1a9cb7bb4/src/GLPOST0.cob#L98-L226",
          "start_line": 98
        }
      ],
      "label": "Normal-balance side interpretation",
      "uncertainties": [
        "Neither-side matches default to the normal side instead of rejecting.",
        "This single-record routine does not provide atomic double-entry posting or journal uniqueness."
      ]
    },
    {
      "@id": "urn:rose:rule.gl_post_guards",
      "@type": "rose:BusinessRule",
      "description": "POST rejects status I/E0061 or F/E0062, zero amount/E0063 and negative amount/E0064. Normal-balance values other than D/C return E0063 after the corresponding branch selection.",
      "epistemic_status": "observed",
      "evidence": [
