          "start_line": 64
        }
      ],
      "label": "Create pending CTR state",
      "uncertainties": [
        "The header comment at line 7 says >=10000, but executable CRTE does not enforce that threshold; threshold branches in TXNPOST0/BSACTRO use >.",
        "CRTE is not idempotent and does not ensure filing completeness or transport acceptance."
      ]
    },
    {
      "@id": "urn:rose:rule.ctr_lifecycle",
      "@type": "rose:BusinessRule",
      "description": "FILE rejects F with E0005 and any other non-P state with E0004; otherwise it sets F and updates timestamp. VOID rejects F with E0006 and any other non-P state with E0004; otherwise it sets V. QURY requires a nonzero customer ID and returns the supplied record unchanged.",
      "epistemic_status": "observed",
      "evidence": [
        {
          "end_line": 181,
          "excerpt_sha256": "5f6403dcec59fa0ee42fb5249d8556faf94e5d25cedc7557c12b6028d1229aa7",
