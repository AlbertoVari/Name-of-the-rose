          "start_line": 7
        }
      ],
      "label": "Local cash threshold flag",
      "predicate": "TXN-CASH-AMOUNT > WS-CTR-THRESHOLD"
    },
    {
      "@id": "urn:rose:rule.txn_positive_amount",
      "@type": "rose:BusinessRule",
      "description": "TXNPOST0 rejects zero with E0031 and negative amounts with E0032 before account changes.",
      "effect": "GOBACK with E0031 for zero or E0032 for negative amount.",
      "epistemic_status": "observed",
